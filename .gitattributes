# Line-ending policy.
# Install.cmd is a Windows batch file: cmd.exe mis-parses anything other than
# CRLF (LF-only or a bare CR at EOF causes "': was unexpected at this time'").
# Force CRLF on every checkout. Install.command is a macOS script -> LF.
tools/installers/Install.cmd text eol=crlf
tools/installers/verify_win.cmd text eol=crlf
*.cmd text eol=crlf
# macOS / shell scripts must stay LF even in a Windows checkout (a CRLF
# Install.command copied from a Windows PC fails on the Mac).
*.command text eol=lf
*.sh text eol=lf
